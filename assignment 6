1. *Membership operators*
items = ['apple', 'banana', 'cherry']
x = 'banana'
print(x in items) # True
print('grape' not in items) # True
2. *Indexing, negative indexing, slicing*
lst = [10, 20, 30, 40, 50]
print(lst[1]) # 20 (indexing)
print(lst[-1]) # 50 (negative indexing)
print(lst[1:4]) # [20, 30, 40] (slicing)
3. *Update, append, insert, delete*
lst = [1, 2, 3]
lst[0] = 10 # update
lst.append(4) # append
lst.insert(1, 15) # insert
lst.remove(3) # delete by value
print(lst) # [10, 15, 2, 4]
4. *Concatenation, repetition, length, max, min*
a = [1, 2]
b = [3, 4]
print(a + b) # concatenation → [1, 2, 3, 4]
print(a * 2) # repetition → [1, 2, 1, 2]
print(len(a)) # length → 2
print(max(b)) # maximum → 4
print(min(b)) # minimum → 3